{
  "name": "skew-cli",
  "version": "0.4.0",
  "description": "Differential fuzzing for LLM stacks: find, classify, and minimize behavioral divergences.",
  "type": "module",
  "bin": {
    "skew": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node src/cli.ts",
    "demo": "node src/cli.ts demo",
    "real:ollama": "node src/cli.ts run --config examples/ollama.config.json",
    "real:omniroute": "node src/cli.ts run --config examples/omniroute.config.json",
    "real:tools": "node src/cli.ts run --config examples/tools.config.json",
    "real:anthropic": "node src/cli.ts run --config examples/omniroute-anthropic.config.json",
    "replay:real": "node src/cli.ts run --config examples/omniroute.config.json --replay docs/real/fixtures",
    "replay:tools": "node src/cli.ts run --config examples/tools.config.json --replay docs/tools/fixtures",
    "replay:anthropic": "node src/cli.ts run --config examples/omniroute-anthropic.config.json --replay docs/anthropic/fixtures",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "llm",
    "differential-testing",
    "fuzzing",
    "evaluation",
    "ai-infrastructure",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
