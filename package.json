{
  "name": "skew-cli",
  "version": "0.9.0",
  "description": "Differential fuzzing for LLM stacks, including argument-aware tool routes, failure-aware workflows, scripted follow-up conversations, and probe-scoped tool environments: find, classify, and minimize behavioral divergences.",
  "type": "module",
  "bin": {
    "skew": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node src/cli.ts",
    "demo": "node src/cli.ts demo",
    "real:ollama": "node src/cli.ts run --config examples/ollama.config.json",
    "real:omniroute": "node src/cli.ts run --config examples/omniroute.config.json",
    "real:tools": "node src/cli.ts run --config examples/tools.config.json",
    "real:anthropic": "node src/cli.ts run --config examples/omniroute-anthropic.config.json",
    "real:agent": "node src/cli.ts run --config examples/agent.config.json",
    "real:agent-failures": "node src/cli.ts run --config examples/agent-failures.config.json",
    "real:conversation": "node src/cli.ts run --config examples/conversation.config.json",
    "real:scenarios": "node src/cli.ts run --config examples/scenarios.config.json",
    "real:tool-routes": "node src/cli.ts run --config examples/tool-routes.config.json",
    "replay:real": "node src/cli.ts run --config examples/omniroute.config.json --replay docs/real/fixtures",
    "replay:tools": "node src/cli.ts run --config examples/tools.config.json --replay docs/tools/fixtures",
    "replay:anthropic": "node src/cli.ts run --config examples/omniroute-anthropic.config.json --replay docs/anthropic/fixtures",
    "replay:agent": "node src/cli.ts run --config examples/agent.config.json --replay docs/agents/fixtures",
    "replay:agent-failures": "node src/cli.ts run --config examples/agent-failures.config.json --replay docs/agent-failures/fixtures",
    "replay:conversation": "node src/cli.ts run --config examples/conversation.config.json --replay docs/conversations/fixtures",
    "replay:scenarios": "node src/cli.ts run --config examples/scenarios.config.json --replay docs/scenarios/fixtures",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "llm",
    "differential-testing",
    "fuzzing",
    "evaluation",
    "agent",
    "tool-calling",
    "conversation",
    "scenario-isolation",
    "failure-injection",
    "argument-routing",
    "ai-infrastructure",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
